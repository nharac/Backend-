# ============================================
# Plantilla de Variables de Entorno - SAESU Backend
# ============================================
# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube a GitHub.
# ============================================

# ===== Base de Datos (Supabase) =====
DB_URL=jdbc:postgresql://<host>:<puerto>/<base-de-datos>?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña>
DB_DRIVER=org.postgresql.Driver

# ===== JWT =====
JWT_SECRET=<clave-secreta-larga-para-HS256>
JWT_EXPIRATION=86400000

# ===== Servidor =====
SERVER_PORT=8080


# ===== GEMINI =====
GEMINI_API_KEY=tu-api-key-aqui
GEMINI_MODEL=gemini-3.8-flash
CHAT_LIMITE_DIARIO=50
# ===== CORREO (SMTP) =====
# Códigos de activación, bienvenida, recuperación de contraseña y notificaciones del foro.
# Cuenta de Gmail de SAESU con contraseña de aplicación (16 letras, sin espacios)
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=contrasena-de-aplicacion-de-16-letras
# Nombre del remitente que se muestra en la bandeja de entrada
MAIL_FROM_NAME=SAESU
# URL pública del frontend (para los botones de los correos)
APP_URL=http://localhost

# ===== AWS S3 (fotos de perfil e imágenes del foro) =====
# Crea un usuario IAM con permiso solo sobre este bucket. Nunca subas estos valores a GitHub.
AWS_ACCESS_KEY_ID=tu-access-key
AWS_SECRET_ACCESS_KEY=tu-secret-key
AWS_REGION=us-east-2
AWS_BUCKET_NAME=nombre-del-bucket

# ===== Zona horaria =====
# Opcional: cuándo empieza "hoy" para el reto del día, rachas, ranking y correos (por defecto America/Bogota)
# SAESU_ZONA_HORARIA=America/Bogota

# Límite de peticiones por minuto e IP. No los cambies en producción;
# súbelos solo mientras corres las pruebas de carga y estrés con JMeter.
# SAESU_RATE_LIMIT_AUTH=10
# SAESU_RATE_LIMIT_API=120
