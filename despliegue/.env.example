# ============================================================
# Variables del despliegue de SAESU (copiar como .env en esta carpeta y llenar).
# El .env NO se sube a GitHub. Se usa el mismo compose en on-premise y en cloud;
# solo cambian los valores de este archivo.
# ============================================================

# --- Dónde está el código del frontend (relativo a esta carpeta) ---
# Servidor AWS (repos lado a lado en /home/ubuntu):  ../../FrontEnd
# PC / VirtualBox con carpetas backend y frontend:   ../../frontend
FRONTEND_DIR=../../FrontEnd

# --- Puerto público del balanceador NGINX ---
PUERTO_HTTP=80
# Solo en cloud con dominio y certificado (activa HTTPS):
# COMPOSE_FILE=compose.yaml:compose.https.yaml

# --- Base de datos (contenedor "db", nunca pública) ---
POSTGRES_DB=saesu
POSTGRES_USER=saesu
POSTGRES_PASSWORD=cambia-esta-clave-larga

# --- Memoria (t3.micro de 1 GB: dejar estos valores y activar swap con scripts/swap.sh) ---
# En t3.small (2 GB) o VirtualBox con 2 GB+ se puede subir a 700m y -Xmx384m.
BACKEND_MEM_LIMIT=480m
DB_MEM_LIMIT=200m
# BACKEND_JAVA_OPTS=-Xms96m -Xmx256m -XX:MaxMetaspaceSize=176m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=48m -Xss512k -XX:+UseSerialGC

# --- Backend (mismas variables del .env.example del backend, sin las de DB_*) ---
JWT_SECRET=
JWT_EXPIRATION=86400000
SERVER_PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_RESPALDO=gemini-3.6-flash
CHAT_LIMITE_DIARIO=30
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=SAESU
APP_URL=http://IP-O-DOMINIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
