<?xml version="1.0" encoding="UTF-8"?>
<!--
  Escenario 7 · Sobrecarga de operaciones CRUD (estrés)
  Crear, actualizar (responder), consultar y eliminar publicaciones al mismo tiempo. Se observan pérdida de datos, inconsistencias y errores de concurrencia; al final se verifica que lo eliminado ya no existe.
  Parámetros: -Jhost=localhost -Jpuerto=8080 -Jprotocolo=http -Jusuarios=.. -Jrampa=.. -Jvueltas=.. -Jmax_ms=2000
  Las cuentas salen de ../usuarios.csv (correo,clave), que NO se sube a git.
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Escenario 7 · Sobrecarga de operaciones CRUD (estrés)">
  <stringProp name="TestPlan.comments">Crear, actualizar (responder), consultar y eliminar publicaciones al mismo tiempo. Se observan pérdida de datos, inconsistencias y errores de concurrencia; al final se verifica que lo eliminado ya no existe.</stringProp>
  <boolProp name="TestPlan.functional_mode">false</boolProp>
  <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
  <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
</TestPlan><hashTree>
<ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Servidor de SAESU">
  <stringProp name="HTTPSampler.protocol">${__P(protocolo,http)}</stringProp>
  <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
  <stringProp name="HTTPSampler.port">${__P(puerto,8080)}</stringProp>
  <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
  <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
</ConfigTestElement><hashTree/>
<HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON">
  <collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header">
    <stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp>
  </elementProp></collectionProp>
</HeaderManager><hashTree/>
<CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Cuentas (usuarios.csv)">
  <stringProp name="filename">${__P(cuentas,../usuarios.csv)}</stringProp>
  <stringProp name="fileEncoding">UTF-8</stringProp>
  <stringProp name="variableNames">correo,clave</stringProp>
  <boolProp name="ignoreFirstLine">true</boolProp>
  <stringProp name="delimiter">,</stringProp>
  <boolProp name="quotedData">false</boolProp>
  <boolProp name="recycle">true</boolProp>
  <boolProp name="stopThread">false</boolProp>
  <stringProp name="shareMode">shareMode.all</stringProp>
</CSVDataSet><hashTree/>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="CRUD simultáneo">
  <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
  <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
    <boolProp name="LoopController.continue_forever">false</boolProp>
    <stringProp name="LoopController.loops">${__P(vueltas,20)}</stringProp>
  </elementProp>
  <stringProp name="ThreadGroup.num_threads">${__P(usuarios,80)}</stringProp>
  <stringProp name="ThreadGroup.ramp_time">${__P(rampa,20)}</stringProp>
  <boolProp name="ThreadGroup.scheduler">false</boolProp>
  <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
</ThreadGroup><hashTree><OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Iniciar sesión (una vez por usuario)"/><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/auth/login">
  <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
  <stringProp name="HTTPSampler.method">POST</stringProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments">
    <elementProp name="" elementType="HTTPArgument">
      <boolProp name="HTTPArgument.always_encode">false</boolProp>
      <stringProp name="Argument.value">{"correo":"${correo}","password":"${clave}"}</stringProp>
      <stringProp name="Argument.metadata">=</stringProp>
    </elementProp></collectionProp></elementProp>
</HTTPSamplerProxy><hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Guardar token">
  <stringProp name="JSONPostProcessor.referenceNames">token</stringProp>
  <stringProp name="JSONPostProcessor.jsonPathExprs">$.token</stringProp>
  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
  <stringProp name="JSONPostProcessor.defaultValues">SIN_TOKEN</stringProp>
</JSONPostProcessor><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login 200">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">200</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">8</intProp>
</ResponseAssertion><hashTree/><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Genera token JWT">
  <stringProp name="JSON_PATH">$.token</stringProp>
  <stringProp name="EXPECTED_VALUE"></stringProp>
  <boolProp name="JSONVALIDATION">false</boolProp>
  <boolProp name="EXPECT_NULL">false</boolProp>
  <boolProp name="INVERT">false</boolProp>
  <boolProp name="ISREGEX">false</boolProp>
</JSONPathAssertion><hashTree/><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Tiempo menor a ${__P(max_ms,2000)} ms">
  <stringProp name="DurationAssertion.duration">${__P(max_ms,2000)}</stringProp>
</DurationAssertion><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Sin errores 5xx">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">5\d\d</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">6</intProp>
</ResponseAssertion><hashTree/></hashTree></hashTree><GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Con token"/><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization: Bearer">
  <collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header">
    <stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${token}</stringProp>
  </elementProp></collectionProp>
</HeaderManager><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/foro/publicaciones (crear)">
  <stringProp name="HTTPSampler.path">/api/foro/publicaciones</stringProp>
  <stringProp name="HTTPSampler.method">POST</stringProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments">
    <elementProp name="" elementType="HTTPArgument">
      <boolProp name="HTTPArgument.always_encode">false</boolProp>
      <stringProp name="Argument.value">{"titulo":"JMETER-${__threadNum}-${__UUID()}","contenido":"Publicación de prueba de carga generada por JMeter. Se elimina al terminar.","tema":"limites"}</stringProp>
      <stringProp name="Argument.metadata">=</stringProp>
    </elementProp></collectionProp></elementProp>
</HTTPSamplerProxy><hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Guardar id de la publicación">
  <stringProp name="JSONPostProcessor.referenceNames">pubId</stringProp>
  <stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp>
  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
  <stringProp name="JSONPostProcessor.defaultValues">NO_ENCONTRADO</stringProp>
</JSONPostProcessor><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Guardar título">
  <stringProp name="JSONPostProcessor.referenceNames">pubTitulo</stringProp>
  <stringProp name="JSONPostProcessor.jsonPathExprs">$.titulo</stringProp>
  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
  <stringProp name="JSONPostProcessor.defaultValues">NO_ENCONTRADO</stringProp>
</JSONPostProcessor><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Crea 201">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">201</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">8</intProp>
</ResponseAssertion><hashTree/><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Devuelve el id creado">
  <stringProp name="JSON_PATH">$.id</stringProp>
  <stringProp name="EXPECTED_VALUE"></stringProp>
  <boolProp name="JSONVALIDATION">false</boolProp>
  <boolProp name="EXPECT_NULL">false</boolProp>
  <boolProp name="INVERT">false</boolProp>
  <boolProp name="ISREGEX">false</boolProp>
</JSONPathAssertion><hashTree/><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Tiempo menor a ${__P(max_ms,2000)} ms">
  <stringProp name="DurationAssertion.duration">${__P(max_ms,2000)}</stringProp>
</DurationAssertion><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Sin errores 5xx">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">5\d\d</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">6</intProp>
</ResponseAssertion><hashTree/></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Solo si se creó la publicación">
  <stringProp name="IfController.condition">${__groovy(vars.get("pubId") != "NO_ENCONTRADO")}</stringProp>
  <boolProp name="IfController.evaluateAll">false</boolProp>
  <boolProp name="IfController.useExpression">true</boolProp>
</IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/foro/publicaciones/{id}/respuestas (actualizar)">
  <stringProp name="HTTPSampler.path">/api/foro/publicaciones/${pubId}/respuestas</stringProp>
  <stringProp name="HTTPSampler.method">POST</stringProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments">
    <elementProp name="" elementType="HTTPArgument">
      <boolProp name="HTTPArgument.always_encode">false</boolProp>
      <stringProp name="Argument.value">{"contenido":"Respuesta de prueba de carga JMeter."}</stringProp>
      <stringProp name="Argument.metadata">=</stringProp>
    </elementProp></collectionProp></elementProp>
</HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Responde 201">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">201</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">8</intProp>
</ResponseAssertion><hashTree/><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Tiempo menor a ${__P(max_ms,2000)} ms">
  <stringProp name="DurationAssertion.duration">${__P(max_ms,2000)}</stringProp>
</DurationAssertion><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Sin errores 5xx">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">5\d\d</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">6</intProp>
</ResponseAssertion><hashTree/></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/foro/publicaciones/{id} (persistencia)">
  <stringProp name="HTTPSampler.path">/api/foro/publicaciones/${pubId}</stringProp>
  <stringProp name="HTTPSampler.method">GET</stringProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
</HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Responde 200">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">200</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">8</intProp>
</ResponseAssertion><hashTree/><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Tiempo menor a ${__P(max_ms,2000)} ms">
  <stringProp name="DurationAssertion.duration">${__P(max_ms,2000)}</stringProp>
</DurationAssertion><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Sin errores 5xx">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">5\d\d</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">6</intProp>
</ResponseAssertion><hashTree/><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="El título guardado es el mismo (integridad)">
  <stringProp name="JSON_PATH">$.titulo</stringProp>
  <stringProp name="EXPECTED_VALUE">${pubTitulo}</stringProp>
  <boolProp name="JSONVALIDATION">true</boolProp>
  <boolProp name="EXPECT_NULL">false</boolProp>
  <boolProp name="INVERT">false</boolProp>
  <boolProp name="ISREGEX">false</boolProp>
</JSONPathAssertion><hashTree/></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="DELETE /api/foro/publicaciones/{id} (eliminar)">
  <stringProp name="HTTPSampler.path">/api/foro/publicaciones/${pubId}</stringProp>
  <stringProp name="HTTPSampler.method">DELETE</stringProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
</HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Elimina 204">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">204</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">8</intProp>
</ResponseAssertion><hashTree/><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Tiempo menor a ${__P(max_ms,2000)} ms">
  <stringProp name="DurationAssertion.duration">${__P(max_ms,2000)}</stringProp>
</DurationAssertion><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Sin errores 5xx">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">5\d\d</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
  <intProp name="Assertion.test_type">6</intProp>
</ResponseAssertion><hashTree/></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET publicación eliminada (debe dar 404)">
  <stringProp name="HTTPSampler.path">/api/foro/publicaciones/${pubId}</stringProp>
  <stringProp name="HTTPSampler.method">GET</stringProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
</HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Ya no existe (404)">
  <collectionProp name="Asserion.test_strings"><stringProp name="c">404</stringProp></collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <boolProp name="Assertion.assume_success">false</boolProp>
